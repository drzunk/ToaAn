<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>vn.tuphap.automation</groupId>
    <artifactId>ToaAn</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <suiteXmlFile>src/test/resources/suites/testng.xml</suiteXmlFile>
        <taodon.suite>full</taodon.suite>
        <taodon.threads>1</taodon.threads>
        <taodon.parallel>false</taodon.parallel>
        <taodon.onlyStt></taodon.onlyStt>
        <taodon.untilStep>6</taodon.untilStep>
        <taodon.submit>false</taodon.submit>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>4.46.0</version>
        </dependency>

        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>7.9.0</version>
        </dependency>

        <!-- Toàn bộ phần báo cáo do dự án tự dựng (BaoCaoHtml → test-output/index.html); Gson chỉ
             để lưu dữ liệu từng lượt chạy ra runs/<mốc>/bao-cao.json. Trước đây Gson về theo
             ExtentReports — thư viện đó đã gỡ (mỗi lượt sinh thêm ~2.5 MB không ai đọc), nên phải
             khai báo tường minh. -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.10.1</version>
        </dependency>

        <dependency>
            <groupId>net.sourceforge.tess4j</groupId>
            <artifactId>tess4j</artifactId>
            <version>5.11.0</version>
        </dependency>

        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>2.15.1</version>
        </dependency>

        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
            <version>2.23.0</version>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>2.23.0</version>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>1.7.36</version>
        </dependency>
        <dependency>
            <groupId>net.datafaker</groupId>
            <artifactId>datafaker</artifactId>
            <version>2.1.0</version>
        </dependency>
        <!-- KHÔNG phải để xuất báo cáo — phần đó đã bỏ. POI ở lại vì TestFileHelper sinh file
             .xlsx/.docx mẫu để kiểm thử chức năng tải tài liệu ở bước 5, và trong
             src/test/resources/testdata/ chỉ có sample.pdf + sample.png. -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.2.5</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <suiteXmlFiles>
                        <suiteXmlFile>${suiteXmlFile}</suiteXmlFile>
                    </suiteXmlFiles>
                    <properties>
                        <property>
                            <name>listener</name>
                            <value>vn.tuphap.automation.core.ParallelSuiteAdjuster</value>
                        </property>
                    </properties>
                    <systemPropertyVariables>
                        <taodon.suite>${taodon.suite}</taodon.suite>
                        <taodon.threads>${taodon.threads}</taodon.threads>
                        <taodon.parallel>${taodon.parallel}</taodon.parallel>
                        <taodon.onlyStt>${taodon.onlyStt}</taodon.onlyStt>
                        <taodon.untilStep>${taodon.untilStep}</taodon.untilStep>
                        <taodon.submit>${taodon.submit}</taodon.submit>
                    </systemPropertyVariables>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>org.apache.maven.surefire</groupId>
                        <artifactId>surefire-testng</artifactId>
                        <version>3.2.5</version>
                    </dependency>
                </dependencies>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>17</release>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>smoke</id>
            <properties>
                <suiteXmlFile>src/test/resources/suites/testng-smoke.xml</suiteXmlFile>
                <taodon.suite>smoke</taodon.suite>
            </properties>
        </profile>
        <profile>
            <id>mid</id>
            <properties>
                <suiteXmlFile>src/test/resources/suites/testng-mid.xml</suiteXmlFile>
                <taodon.suite>mid</taodon.suite>
            </properties>
        </profile>
        <profile>
            <id>full</id>
            <properties>
                <suiteXmlFile>src/test/resources/suites/testng.xml</suiteXmlFile>
                <taodon.suite>full</taodon.suite>
            </properties>
        </profile>
        <profile>
            <id>login</id>
            <properties>
                <suiteXmlFile>src/test/resources/suites/testng-login.xml</suiteXmlFile>
                <taodon.suite>login</taodon.suite>
            </properties>
        </profile>
        <profile>
            <id>unit</id>
            <properties>
                <suiteXmlFile>src/test/resources/suites/testng-unit.xml</suiteXmlFile>
                <taodon.suite>full</taodon.suite>
            </properties>
        </profile>
        <!-- Bộ quét dò field (Giai đoạn 1) — không assert, chỉ ghi báo cáo CSV. Chạy riêng, không nằm trong smoke/mid/full/master. -->
        <profile>
            <id>discovery</id>
            <properties>
                <suiteXmlFile>src/test/resources/suites/testng-discovery.xml</suiteXmlFile>
                <taodon.suite>discovery</taodon.suite>
            </properties>
        </profile>
        <profile>
            <id>master</id>
            <properties>
                <suiteXmlFile>src/test/resources/suites/testng-master.xml</suiteXmlFile>
                <taodon.suite>smoke</taodon.suite>
            </properties>
        </profile>
        <!-- Plan run: 3 Chrome song song — mỗi case đúng 1 lần -->
        <profile>
            <id>parallel-smoke</id>
            <properties>
                <suiteXmlFile>src/test/resources/suites/testng-parallel-smoke.xml</suiteXmlFile>
                <taodon.suite>smoke</taodon.suite>
                <taodon.threads>3</taodon.threads>
                <taodon.parallel>true</taodon.parallel>
            </properties>
        </profile>
        <profile>
            <id>parallel-mid</id>
            <properties>
                <suiteXmlFile>src/test/resources/suites/testng-parallel-mid.xml</suiteXmlFile>
                <taodon.suite>mid</taodon.suite>
                <taodon.threads>3</taodon.threads>
                <taodon.parallel>true</taodon.parallel>
            </properties>
        </profile>
        <profile>
            <id>parallel-full</id>
            <properties>
                <suiteXmlFile>src/test/resources/suites/testng-parallel-full.xml</suiteXmlFile>
                <taodon.suite>full</taodon.suite>
                <taodon.threads>3</taodon.threads>
                <taodon.parallel>true</taodon.parallel>
            </properties>
        </profile>
        <profile>
            <id>parallel-buoc23</id>
            <properties>
                <suiteXmlFile>src/test/resources/suites/testng-parallel-buoc23.xml</suiteXmlFile>
                <taodon.suite>full</taodon.suite>
                <taodon.threads>3</taodon.threads>
                <taodon.parallel>true</taodon.parallel>
            </properties>
        </profile>
    </profiles>
</project>